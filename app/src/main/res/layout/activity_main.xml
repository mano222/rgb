<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bk_color"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/scan_but"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/rgbfusion" />

                <TextView
                    android:id="@+id/err_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/err_msg2"
                    android:layout_centerHorizontal="true"
                    android:layout_marginRight="50dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/Err_msg"
                    android:textColor="@color/txt_color"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/err_msg2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="50dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/Err_msg2"
                    android:textColor="@color/item_bg"
                    android:textSize="18sp" />
            </RelativeLayout>

            <ListView
                android:id="@+id/cmp_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bk_color"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/list_selector"
                android:visibility="invisible" />
        </RelativeLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/scan_but"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rescan"
        android:contentDescription="@string/scan_button"
        android:scaleType="fitCenter"
        android:src="@drawable/rescan" />
</RelativeLayout>
