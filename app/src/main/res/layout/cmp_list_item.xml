<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp">

        <ImageView
            android:id="@+id/cmp_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/pc" />

        <TextView
            android:id="@+id/cmp_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/cmp_icon"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="32dp"
            android:layout_toEndOf="@+id/cmp_icon"
            android:singleLine="true"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/pc_item_title" />

        <TextView
            android:id="@+id/cmp_ip_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/cmp_icon"
            android:layout_toEndOf="@+id/cmp_icon"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/pc_item_ip" />

        <CheckBox
            android:id="@+id/group_sel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="visible" />
    </RelativeLayout>
</RelativeLayout>
