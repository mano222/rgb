<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bk_color"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp">

        <Button
            android:id="@+id/apply_but"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/butcolor"
            android:text="@string/Apply_str"
            android:textColor="@color/item_bg" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_margin="10dp"
            android:text="@string/O4_str"
            android:textColor="@color/txt_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/title_text"
            android:background="@color/txt_color"
            android:orientation="horizontal" />
    </RelativeLayout>

    <TextView
        android:id="@+id/s_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_layout"
        android:layout_alignStart="@+id/s_picker"
        android:layout_marginTop="10dp"
        android:text="@string/S_time_str"
        android:textColor="@color/txt_color"
        android:textSize="24sp" />

    <TimePicker
        android:id="@+id/s_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/s_label"
        android:layout_centerHorizontal="true"
        android:background="@color/txt_color"
        android:timePickerMode="spinner" />

    <TextView
        android:id="@+id/e_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/e_picker"
        android:layout_alignStart="@+id/e_picker"
        android:text="@string/E_time_str"
        android:textColor="@color/txt_color"
        android:textSize="24sp" />

    <TimePicker
        android:id="@+id/e_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:background="@color/txt_color"
        android:timePickerMode="spinner" />
</RelativeLayout>
